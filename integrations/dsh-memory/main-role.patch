+
+/** A parent preserves lineage; only trusted presets opt parented roots into full-turn distillation. */
+export function canSummarizeSession(header, parentedRootPresets = []) {
+  if (header === undefined || header.origin === 'subagent') return false
+  return header.parentSession === undefined || parentedRootPresets.includes(header.agentPreset)
+}
+
+/** Start first-time distillation at the latest native turn, not the beginning of a long journal. */
+export function memoryEventWindow(events, fromSeq) {
+  const fresh = events.filter(event => !(event.type === 'user/message' && event.data?.source?.kind === 'runtime-context'))
+  if (fromSeq > 0) return fresh.filter(event => event.seq > fromSeq)
+  const at = fresh.findLastIndex(event => event.type === 'turn/start')
+  return at < 0 ? fresh : fresh.slice(at)
+}
