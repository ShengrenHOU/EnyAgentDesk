{
  "name": "dsh-superagent",
  "author": "Shengren HOU <257998252+ShengrenHOU@users.noreply.github.com>",
  "contributors": [
    "DeepSeek Harness Team (upstream dsh-superagent-prototype)"
  ],
  "license": "Apache-2.0",
  "version": "0.5.32",
  "private": true,
  "description": "Persistent personal work coordination as a DeepSeek Harness bundle, with Codex and DSH execution, Feishu intake and optional GitHub integration.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShengrenHOU/EnyAgentDesk.git"
  },
  "homepage": "https://github.com/ShengrenHOU/EnyAgentDesk#readme",
  "bugs": {
    "url": "https://github.com/ShengrenHOU/EnyAgentDesk/issues"
  },
  "keywords": [
    "deepseek-harness",
    "agent",
    "workbench",
    "ticket",
    "codex",
    "feishu"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./github-watch": "./lib/github-watch.js",
    "./feishu-watch": "./lib/feishu-watch.js",
    "./activity-watch": "./lib/activity-watch.js",
    "./workbench": "./lib/workbench.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "LICENSE",
    "LICENSES",
    "NOTICE",
    "README.md",
    "prompts",
    "skills",
    "scripts/*.py",
    "scripts/**/*.mjs",
    "scripts/*.ps1",
    "scripts/dsh-superagent",
    "examples/install.minimal.json",
    "INSTALL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "check:native": "tsc --noEmit && vitest run tests/codex-rpc.spec.ts tests/codex-executor.spec.ts tests/windows-environment.spec.ts tests/core-engine.spec.ts tests/policy.spec.ts tests/docs.spec.ts tests/class-docs.spec.ts && tsdown",
    "check:codex-live": "vitest run tests/codex-live.spec.ts",
    "check:owner-launcher": "python tests/test_owner_launcher.py"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "packageManager": "pnpm@11.28.10",
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-alpha.2",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-permission-presets": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-workspace": "^0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/jsdom": "28.0.3",
    "@types/node": "22.20.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
